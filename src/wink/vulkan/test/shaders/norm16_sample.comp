#version 450
layout(local_size_x = 1) in;
layout(set = 0, binding = 0) uniform sampler2D source_image;
layout(set = 0, binding = 1, std430) buffer Output { vec4 values[2]; } output_data;
void main() {
    output_data.values[0] = textureLod(source_image, vec2(0.25), 0.0);
    output_data.values[1] = textureLod(source_image, vec2(0.5), 0.0);
}

<!--
  wink for a .NET 10 browser-wasm app (WasmBuildNative). Generated by
  wink/build.sh for the @VARIANT@ variant; import it from the app's project,
  after the app's own properties (the knobs below are read at import):

    <Import Project="path/to/wink/@VARIANT@/wink.targets" />

  Knobs, all optional:
    WinkLinkWebGPUGlue=false  the app already links emdawnwebgpu's webgpu.cpp
    WinkLinkWebGPUJs=false    ... and passes its four library_webgpu*.js
                              itself; they must be the same emdawnwebgpu
                              release (v20250428.134257), and wink's copies
                              carry fixes a stock copy lacks. Defaults to
                              WinkLinkWebGPUGlue.
    WinkLinkTint=false        the app already links the same Tint
                              (MobileGL's, from the same Dawn revision)

  The stack is raised to 16MB, since Tint and the GLSL compiler recurse
  deeply, unless the app already chose one through EmccStackSize or a
  STACK_SIZE in EmccExtraLDFlags. GL runs on whichever thread the app calls it from, and
  that thread's stack is what matters: with WasmEnableThreads, a pthread's.
  Those are 2MB each (DEFAULT_PTHREAD_STACK_SIZE), unless the app chose:
  not the stack's 16MB for every thread. GL compiles in well under a
  megabyte, and Tint goes to a stack of its own on a thread of less.
-->
<Project>
  <PropertyGroup>
    <WinkRoot>$(MSBuildThisFileDirectory)</WinkRoot>
    <WinkVariant>@VARIANT@</WinkVariant>
    <WasmBuildNative>true</WasmBuildNative>
    <WinkLinkWebGPUJs Condition="'$(WinkLinkWebGPUJs)' == ''">$(WinkLinkWebGPUGlue)</WinkLinkWebGPUJs>
    <EmccStackSize Condition="'$(EmccStackSize)' == '' and !$(EmccExtraLDFlags.Contains('STACK_SIZE'))">16MB</EmccStackSize>
  </PropertyGroup>

  <ItemGroup>
    <NativeFileReference Include="$(WinkRoot)lib/libwink.a" />
    <NativeFileReference Include="$(WinkRoot)lib/libwink_webgpu.a" Condition="'$(WinkLinkWebGPUGlue)' != 'false'" />
    <NativeFileReference Include="$(WinkRoot)lib/libwink_tint.a" Condition="'$(WinkLinkTint)' != 'false'" />
  </ItemGroup>

  <PropertyGroup Condition="'$(WinkVariant)' == 'mt' and !$(EmccExtraLDFlags.Contains('DEFAULT_PTHREAD_STACK_SIZE'))">
    <EmccExtraLDFlags>$(EmccExtraLDFlags) -sDEFAULT_PTHREAD_STACK_SIZE=2MB</EmccExtraLDFlags>
  </PropertyGroup>

  <PropertyGroup>
    <!-- In this order: library_webgpu.js is preprocessed with the three tables. -->
    <_WinkWebGPUJs Condition="'$(WinkLinkWebGPUJs)' != 'false'">@WEBGPU_JS@</_WinkWebGPUJs>
    <EmccExtraLDFlags>$(EmccExtraLDFlags) @REQUIRED_FLAGS@ $(_WinkWebGPUJs) @WINK_JS@</EmccExtraLDFlags>
  </PropertyGroup>

  <Target Name="WinkCheckVariant" BeforeTargets="Build">
    <Error Condition="'$(WinkVariant)' == 'mt' and '$(WasmEnableThreads)' != 'true'"
           Text="wink: the mt build needs WasmEnableThreads=true; use the st build otherwise." />
    <Error Condition="'$(WinkVariant)' == 'st' and '$(WasmEnableThreads)' == 'true'"
           Text="wink: the st build cannot link into a WasmEnableThreads app; use the mt build." />
  </Target>
</Project>

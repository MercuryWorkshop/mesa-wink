+// wink: a command buffer Metal failed -- a GPU hang or fault -- loses the device: after one,
+// the system ignores the process's work (kIOGPUCommandBufferCallbackErrorSubmissionsIgnored),
+// which would else be lost without a word.
+MaybeError Queue::CheckCommandBufferFailure() {
+    if (mCommandBufferFailed.load()) {
+        return DAWN_DEVICE_LOST_ERROR("A Metal command buffer failed (GPU hang or fault).");
+    }
+    return {};
+}

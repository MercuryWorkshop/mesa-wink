From dcc5a4962df7f56bfc716954672eed79b133b0f8 Mon Sep 17 00:00:00 2001
From: Mesa CI <mesa@example.com>
Date: Mon, 28 Sep 2026 19:05:23 -0700
Subject: [PATCH] osx: a wink GL context factory (--deqp-gl-context-type=wink)

Contexts of the libwink.dylib that DEQP_WINK_LIBRARY names -- mesa-wink's
GL on WebGPU -- with an offscreen default framebuffer, built when
DEQP_WINK_INCLUDE_DIR names the directory holding wink.h.
---
 framework/platform/CMakeLists.txt             |  10 +
 framework/platform/osx/tcuOSXPlatform.cpp     |   6 +
 .../platform/osx/tcuOSXWinkContextFactory.cpp | 313 ++++++++++++++++++
 .../platform/osx/tcuOSXWinkContextFactory.hpp |  40 +++
 4 files changed, 369 insertions(+)
 create mode 100644 framework/platform/osx/tcuOSXWinkContextFactory.cpp
 create mode 100644 framework/platform/osx/tcuOSXWinkContextFactory.hpp

diff --git a/framework/platform/CMakeLists.txt b/framework/platform/CMakeLists.txt
index 8f6e0c5..6320fd0 100644
--- a/framework/platform/CMakeLists.txt
+++ b/framework/platform/CMakeLists.txt
@@ -176,6 +176,16 @@ if (NOT DEFINED TCUTIL_PLATFORM_SRCS)
 			osx/tcuOSXMetalView.hpp
 			)
 		list(APPEND TCUTIL_PLATFORM_LIBS ${QUARTZCORE_LIBRARY} ${COCOA_LIBRARY})
+		# wink's GL (--deqp-gl-context-type=wink): the directory holding wink.h.
+		set(DEQP_WINK_INCLUDE_DIR "" CACHE PATH "Build the wink GL context factory against wink.h in this directory")
+		if (DEQP_WINK_INCLUDE_DIR)
+			list(APPEND TCUTIL_PLATFORM_SRCS
+				osx/tcuOSXWinkContextFactory.cpp
+				osx/tcuOSXWinkContextFactory.hpp
+				)
+			include_directories(${DEQP_WINK_INCLUDE_DIR})
+			add_definitions(-DDEQP_SUPPORT_WINK=1)
+		endif ()
 
 	elseif (DE_OS_IS_FUCHSIA)
 		set(TCUTIL_PLATFORM_SRCS
diff --git a/framework/platform/osx/tcuOSXPlatform.cpp b/framework/platform/osx/tcuOSXPlatform.cpp
index 7ae7ae0..32ea028 100644
--- a/framework/platform/osx/tcuOSXPlatform.cpp
+++ b/framework/platform/osx/tcuOSXPlatform.cpp
@@ -25,6 +25,9 @@
 #include "tcuRenderTarget.hpp"
 
 #include "tcuOSXVulkanPlatform.hpp"
+#if defined(DEQP_SUPPORT_WINK)
+#include "tcuOSXWinkContextFactory.hpp"
+#endif
 
 #include "gluDefs.hpp"
 #include "gluPlatform.hpp"
@@ -97,6 +100,9 @@ public:
     OSXGLPlatform(void)
     {
         m_contextFactoryRegistry.registerFactory(new CGLContextFactory());
+#if defined(DEQP_SUPPORT_WINK)
+        m_contextFactoryRegistry.registerFactory(osx::createWinkContextFactory());
+#endif
     }
 
     ~OSXGLPlatform(void)
diff --git a/framework/platform/osx/tcuOSXWinkContextFactory.cpp b/framework/platform/osx/tcuOSXWinkContextFactory.cpp
new file mode 100644
index 0000000..cd02fbd
--- /dev/null
+++ b/framework/platform/osx/tcuOSXWinkContextFactory.cpp
@@ -0,0 +1,313 @@
+/*-------------------------------------------------------------------------
+ * drawElements Quality Program Tester Core
+ * ----------------------------------------
+ *
+ * Copyright 2026 wink contributors
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *

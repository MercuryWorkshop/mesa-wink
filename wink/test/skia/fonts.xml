    <font weight="700" style="italic">wink_fonts/Roboto-BoldItalic.ttf</font>
  </family>
  <alias name="Roboto" to="sans-serif"/>
  <alias name="Arial" to="sans-serif"/>
  <alias name="Helvetica" to="sans-serif"/>
